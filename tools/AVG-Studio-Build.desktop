[Desktop Entry]
# Double-click this file in a file manager to run build_flatpak.ps1 in a
# real, visible terminal - no need to open one and type the command.
# First use: most file managers ask you to confirm you trust this
# specific file before running it (their own one-time safety prompt).
#
# `Terminal=true` is the standard freedesktop.org key that makes the
# launcher open a terminal emulator and run `Exec` inside it. `%k` is the
# standard field code for this .desktop file's own path, used to find
# build_flatpak.ps1 sitting beside it without a hardcoded absolute path.
# Exec is NOT run through a shell by the spec - it has its own quoting
# rules (double quotes only, backslash-escaped $ " ` \) - so the shell
# logic lives in one `bash -c` string. The build tool is PowerShell
# (`pwsh`); if it is missing the launcher says so instead of vanishing,
# and the final `read` keeps the window open after the script exits so
# a build error or the final `flatpak install` hint is readable.
Type=Application
Name=AVG Studio — Build / Launch
Comment=Interactive menu: launch AVG Studio from source, or build the Flatpak package
Exec=bash -c "d=\$(dirname \"\$1\"); if command -v pwsh >/dev/null 2>&1; then pwsh -NoProfile -File \"\$d/build_flatpak.ps1\"; else echo \"pwsh (PowerShell 7+) is not installed - build_flatpak.ps1 needs it. On CachyOS/Arch: yay -S powershell-bin\"; fi; echo; read -n 1 -s -r -p \"Press any key to close this window...\"" bash %k
Icon=utilities-terminal
Terminal=true
Categories=Development;
StartupNotify=true
